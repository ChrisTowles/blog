{
  "name": "chris-towles-blog",
  "version": "0.1.0",
  "private": true,
  "author": "Chris Towles<Chris.Towles@gmail.com>",
  "maintainers": [
    "Chris Towles<Chris.Towles@gmail.com>"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @chris-towles/blog build",
    "kill-port": "bash -c '. .env 2>/dev/null; fuser -k ${UI_PORT:-3000}/tcp 2>/dev/null; fuser -k ${MCP_PORT:-8081}/tcp 2>/dev/null; pkill -f \"v[i]te build --watch --config mcp-ui\" 2>/dev/null; exit 0'",
    "mcp:dev": "bash -c '. .env 2>/dev/null; pnpm --filter @chris-towles/mcp dev --port ${MCP_PORT:-8081}'",
    "ui-bundle:build": "pnpm --filter @chris-towles/blog build:ui-bundle",
    "ui-bundle:watch": "pnpm --filter @chris-towles/blog build:ui-bundle:watch",
    "dev": "pnpm db:migrate && pnpm kill-port && pnpm ui-bundle:build && (pnpm mcp:dev &) && (pnpm ui-bundle:watch &) && pnpm --filter @chris-towles/blog dev",
    "dev:no-remote": "pnpm db:migrate && pnpm kill-port && pnpm ui-bundle:build && (pnpm mcp:dev &) && (pnpm ui-bundle:watch &) && pnpm --filter @chris-towles/blog dev:no-remote",
    "cf:deploy": "pnpm build && pnpm --filter @chris-towles/blog exec wrangler deploy && pnpm --filter @chris-towles/mcp run deploy",
    "cf:deploy:staging": "pnpm build && pnpm --filter @chris-towles/blog exec wrangler deploy --env staging && pnpm --filter @chris-towles/mcp deploy:staging",
    "cf:migrate": "pnpm --filter @chris-towles/blog db:migrate:prod",
    "cf:migrate:staging": "pnpm --filter @chris-towles/blog db:migrate:staging",
    "cf:tail": "pnpm --filter @chris-towles/blog exec wrangler tail --format pretty",
    "cf:tail:staging": "pnpm --filter @chris-towles/blog exec wrangler tail --env staging --format pretty",
    "db:generate": "pnpm --filter @chris-towles/blog db:generate",
    "db:migrate": "pnpm --filter @chris-towles/blog db:migrate",
    "db:studio": "pnpm --filter @chris-towles/blog db:studio",
    "etl:aviation": "pnpm --filter @chris-towles/blog etl:aviation",
    "gen:card-portraits": "pnpm tsx scripts/generate-card-portraits.ts",
    "gen:cards": "pnpm --filter @chris-towles/blog gen:cards",
    "lint": "oxlint --ignore-pattern '.claude/worktrees/**' .",
    "lint:fix": "oxlint --ignore-pattern '.claude/worktrees/**' --fix-dangerously .",
    "lint:comments": "comment-budget",
    "lint:comments:all": "comment-budget --all --report",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm --filter @chris-towles/blog typecheck",
    "typecheck:precommit": "pnpm tsx scripts/typecheck-precommit.ts",
    "ci:set-anthropic-key": "pnpm tsx scripts/setup-ci-anthropic-key.ts",
    "test": "pnpm --filter @chris-towles/blog test",
    "test:integration": "pnpm --filter @chris-towles/blog test:integration",
    "test:e2e": "pnpm --filter @chris-towles/blog test:e2e",
    "prepare": "simple-git-hooks",
    "mcp:inspect": "pnpm dlx @modelcontextprotocol/inspector",
    "deps:update": "pnpm dlx taze --interactive --recursive",
    "clean": "rm -rf node_modules packages/*/node_modules .nuxt .output .nitro dist packages/*/.nuxt packages/*/.output pnpm-lock.yaml"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@third-option/comment-budget": "^0.1.0",
    "@types/node": "^24.13.2",
    "citty": "^0.2.2",
    "cli-table3": "^0.6.5",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "find-up": "^8.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright-chromium": "^1.64.1",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "strip-json-comments": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "zod": "^4.6.7",
    "zx": "^8.8.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm format && pnpm typecheck:precommit"
  },
  "lint-staged": {
    "*.png": "pnpm tsx scripts/compress-images.ts",
    "*.{ts,tsx,mts,cts,js,cjs,mjs}": [
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{ts,tsx,mts,cts,js,cjs,mjs,json,css,html,vue}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@duckdb/node-bindings",
      "@parcel/watcher",
      "@playwright/browser-chromium",
      "@swc/core",
      "@third-option/comment-budget",
      "better-sqlite3",
      "esbuild",
      "playwright-chromium",
      "protobufjs",
      "sharp",
      "simple-git-hooks",
      "unrs-resolver",
      "vue-demi",
      "workerd"
    ],
    "packageExtensions": {
      "@nuxt/content": {
        "dependencies": {
          "h3": "1.15.11"
        }
      },
      "vue-router": {
        "peerDependencies": {
          "@vue/language-core": "*"
        }
      }
    }
  }
}
