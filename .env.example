# Rendered into .env by `tt task new` / `tt task env` — ${tt:...} tokens are
# per-task substitutions (port pools, task identity). Copying by hand instead?
# Replace each token with a concrete value.

# Task identity (worktree-task convention; harmless in the main checkout)
TASK_NAME=${tt:task-name}
PR_BASE=${tt:base}

# Per-task dev server port (required for worktree support)
UI_PORT=${tt:port 3000-3019}
# MCP dev server port (package.json mcp:dev / kill-port read this)
MCP_PORT=${tt:port 8081-8099}

# Setup step `tt task new` runs in a fresh task (spawned directly, no shell).
TT_TASK_SETUP=pnpm install --prefer-offline

# Password for nuxt-auth-utils (minimum 32 characters)
NUXT_SESSION_PASSWORD=

# Unlocks POST /api/_dev/session, which E2E specs use to mint a session without
# a real OAuth round-trip. The route 404s unless this is set and the request
# presents the same value. Local + CI only — never set it in a deployed env.
NUXT_DEV_SESSION_SECRET=local-e2e-dev-session-secret
# Anthropic API Key
ANTHROPIC_API_KEY=

# Site URL (used for generating absolute URLs in search/chat results)
# Local dev uses request origin automatically; this is for the Agent SDK tools
# NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (optional — analytics disabled if unset)
# NUXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX

#### Github OAuth apps###
# https://github.com/settings/developers
# GitHub OAuth client ID
NUXT_OAUTH_GITHUB_CLIENT_ID=
# GitHub OAuth client secret
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

#### Google OAuth ###
# https://console.cloud.google.com/apis/credentials
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=



# Aviation Parquet lives in R2 under the `aviation/` prefix. Only the ETL (pnpm etl:aviation)
# uploads through the S3 API with these; the container reads via the Worker (docs/mcp-aviation-ops.md).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

### Braintrust API keys ###
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=

# Nuxt OG Image signing secret — prevents arbitrary image generation
# Generate with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=

# OpenTelemetry / New Relic (free tier) — evlog OTLP drain (REQUIRED)
# Local dev sends to the same New Relic account as staging/prod; OTEL_SERVICE_NAME
# (or the dev's user) is what separates the streams. Get a license key from
# https://one.newrelic.com → API keys → INGEST - LICENSE.
# US datacenter:  https://otlp.nr-data.net
# EU datacenter:  https://otlp.eu01.nr-data.net
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
OTEL_EXPORTER_OTLP_HEADERS=api-key=YOUR_NEW_RELIC_LICENSE_KEY
OTEL_SERVICE_NAME=blog-dev