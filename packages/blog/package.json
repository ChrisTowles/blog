{
  "name": "@chris-towles/blog",
  "version": "0.1.0",
  "private": true,
  "author": "Chris Towles<Chris.Towles@gmail.com>",
  "maintainers": [
    "Chris Towles<Chris.Towles@gmail.com>"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run build:ui-bundle && NODE_OPTIONS=--max-old-space-size=8192 nuxt build",
    "build:ui-bundle": "vite build --config mcp-ui/aviation-answer/vite.config.ts && vite build --config mcp-ui/echo/vite.config.ts",
    "build:ui-bundle:watch": "bash -c 'vite build --watch --config mcp-ui/aviation-answer/vite.config.ts & vite build --watch --config mcp-ui/echo/vite.config.ts & wait'",
    "dev": "nuxt dev --dotenv ../../.env",
    "dev:debug": "DEBUG=*:*:*,vite:*:*  nuxt dev --dotenv ../../.env",
    "generate": "nuxt generate",
    "preview": "wrangler dev --env dev",
    "postinstall": "nuxt prepare",
    "lint": "oxlint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "NODE_OPTIONS='--import ./vitest.preload.mjs' vitest",
    "test:integration": "NODE_OPTIONS='--import ./vitest.preload.mjs' vitest -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:ui-bundle:e2e": "playwright test --config=mcp-ui/aviation-answer/playwright.config.ts",
    "cleanup": "npx nuxi cleanup",
    "etl:aviation": "tsx scripts/etl-aviation.ts",
    "gen:cards": "tsx scripts/generate-card-decks.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local --env dev",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "cf:types": "wrangler types --include-runtime false server/worker-configuration.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@cloudflare/containers": "0.3.7",
    "@iconify-json/simple-icons": "^1.2.100",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/mdc": "^0.23.2",
    "@opentelemetry/api": "^1.10.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "braintrust": "^3.39.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "evlog": "^2.33.1",
    "find-up": "^8.0.0",
    "h3": "^1.15.11",
    "mermaid": "^11.16.0",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "nuxt-og-image": "^6.7.0",
    "pixi.js": "^8.22.0",
    "satori": "^0.63.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "^5.4.2",
    "ufo": "^1.6.4",
    "vue-echarts": "^8.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@duckdb/node-api": "1.5.2-r.2",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/heroicons-outline": "^1.2.1",
    "@iconify-json/logos": "^1.2.17",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.2.0",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/sitemap": "^8.2.2",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.2",
    "@vue/language-core": "^3.3.13",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "baseline-browser-mapping": "^2.11.30",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.10.6",
    "nuxt-gtag": "^4.1.0",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.3"
  }
}
